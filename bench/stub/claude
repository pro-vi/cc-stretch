#!/usr/bin/env bun
// A stand-in for `claude -p --output-format json`, so the guide bench runs end to end without a
// model. Put this folder first on PATH. It answers a writer with a fixed reply that stretches each
// item of a three-item list, and a judge with the JSON each prompt asks for, as Claude Code 2.1.301
// prints it: a list of events whose result event holds the answer and names the model.
//   STUB_JUDGE=key|labels    the judge answers "maybe" for each key verdict, or each label
//   STUB_FAIL_MATCH=<regex>  a prompt matching <regex> fails, as a refused request does
//   STUB_RESOLVE=<suffix>    the model each call resolves to gets <suffix>, as after a model update
//   STUB_VERSION=<text>      what `claude --version` prints
const args = process.argv.slice(2)
if (args.includes('--version')) {
  console.log(process.env.STUB_VERSION ?? '9.9.9 (Claude Code)')
  process.exit(0)
}
const prompt = args.at(-1) ?? ''
const model = `stub-${args[args.indexOf('--model') + 1] ?? 'model'}${process.env.STUB_RESOLVE ?? ''}`
const count = tag => (new RegExp(`<${tag}>\\n([\\s\\S]*?)\\n</${tag}>`).exec(prompt)?.[1] ?? '').split('\n').filter(line => /^\d+\. /.test(line)).length
const verdicts = (n, word, garbled) => Array.from({ length: n }, () => (process.env.STUB_JUDGE === garbled ? 'maybe' : word))

let answer
if (process.env.STUB_FAIL_MATCH !== undefined && new RegExp(process.env.STUB_FAIL_MATCH).test(prompt)) answer = undefined
else if (prompt.includes('Output only JSON of the form {"points"')) answer = JSON.stringify({ points: ['Memory is fast.', 'Redis is shared.'] })
else if (prompt.includes('Write down, as a short numbered list')) answer = '1. Memory is fast.\n2. Redis is shared.'
else if (prompt.includes('{"verdicts":["yes","no"]}')) answer = JSON.stringify({ verdicts: verdicts(count('points'), 'yes', 'key') })
else if (prompt.includes('{"verdicts":{"1":"gist"}}')) {
  // A phrase marked in the reply is a label when it ends in a colon, and a gist otherwise.
  const reply = /<reply>\n([\s\S]*)\n<\/reply>/.exec(prompt)?.[1] ?? ''
  const phrases = [...reply.matchAll(/⟦(\d+)⟧([\s\S]*?)⟦\/\1⟧/g)].map(m => m[2])
  answer = JSON.stringify({ verdicts: Object.fromEntries(phrases.map((phrase, i) => [String(i + 1), process.env.STUB_JUDGE === 'labels' ? 'maybe' : phrase.trim().endsWith(':') ? 'label' : 'gist'])) })
} else if (prompt.includes('{"know":["yes"],"never":["no"]}')) answer = JSON.stringify({ know: verdicts(count('points'), 'yes', 'key'), never: verdicts(count('claims'), 'no', 'key') })
else answer = 'The options are below.\n\n- {{Memory is fast.|Memory is fast, but lost on restart.}}\n- {{SQLite persists.|SQLite persists locally, unshared.}}\n- {{Redis is shared.|Redis is shared across replicas.}}'

const result = answer === undefined
  ? { type: 'result', is_error: true, result: 'API Error: the stub refused this prompt' }
  : { type: 'result', is_error: false, result: answer, modelUsage: { [model]: {} } }
console.log(JSON.stringify([{ type: 'system', model }, { type: 'assistant', message: { model } }, result]))
process.exit(answer === undefined ? 1 : 0)
